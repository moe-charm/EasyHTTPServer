<Window x:Class="EasyHttpServer.Desktop.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - EasyHTTPServer 2" Width="720" Height="520" Icon="Assets/AppIcon.ico"
        MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Padding="8" TabIndex="0" AutomationProperties.Name="設定カテゴリ">
            <TabItem Header="一般">
                <StackPanel Margin="18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="一般" />
                    <TextBlock Margin="0,18,0,6" Text="ファイル共有の待ち受けポート" />
                    <TextBox Width="120" HorizontalAlignment="Left" Padding="8,6" TabIndex="1"
                             AutomationProperties.Name="待ち受けポート"
                             IsEnabled="{Binding CanEditFileSharingConfiguration}"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="ファイル共有ポート、テーマ、両モードのフォルダーは終了時に安全なJSON設定へ保存します。WebサイトのポートとLAN/VPN公開状態は保存しません。" />
                </StackPanel>
            </TabItem>
            <TabItem Header="共有">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="共有フォルダー" />
                    <DataGrid Grid.Row="2" TabIndex="1" ItemsSource="{Binding Shares}" AutoGenerateColumns="False"
                              AutomationProperties.Name="共有フォルダー設定一覧"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="URL" Binding="{Binding Slug, StringFormat=/s/{0}/}" Width="140" />
                            <DataGridTextColumn Header="フォルダー" Binding="{Binding RootPath}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="ネットワーク">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="ネットワーク" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="通常はメイン画面の『ほかの端末にも公開』だけで選べます。ここでは接続方法を明示的に変更できます。" />
                    <RadioButton Margin="0,18,0,8" GroupName="NetworkScope" IsEnabled="{Binding CanEditConfiguration}"
                                 IsChecked="{Binding IsLocalOnly}" Content="このPCだけ" />
                    <RadioButton Margin="0,8" GroupName="NetworkScope" IsEnabled="{Binding CanEditConfiguration}"
                                 IsChecked="{Binding IsLanEnabled}" Content="家庭内LAN経由" />
                    <TextBlock Margin="0,6,0,6" Text="待ち受けネットワーク" />
                    <ComboBox IsEnabled="{Binding CanEditConfiguration}" ItemsSource="{Binding LanNetworks}"
                              SelectedItem="{Binding SelectedLanNetwork}" DisplayMemberPath="DisplayText"
                              AutomationProperties.Name="LAN待ち受けネットワーク" />
                    <RadioButton Margin="0,18,0,8" GroupName="NetworkScope" IsEnabled="{Binding CanEditConfiguration}"
                                 IsChecked="{Binding IsVpnEnabled}" Content="VPN経由" />
                    <TextBlock Margin="0,6,0,6" Text="VPNアダプター" />
                    <ComboBox IsEnabled="{Binding CanEditConfiguration}" ItemsSource="{Binding VpnNetworks}"
                              SelectedItem="{Binding SelectedVpnNetwork}" DisplayMemberPath="DisplayText"
                              AutomationProperties.Name="VPN待ち受けネットワーク" />
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Text="LAN公開は選択したプライベートIPv4へHTTPSで待ち受け、8桁の短時間ペアリングを必須にします。コードは5分または初回成功まで有効です。開始直前に公開対象を確認します。" />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="VPN公開は選択した仮想アダプターのIPだけへ待ち受けます。VPNソフトの接続やアカウントはEasyHTTPServerから操作しません。" />
                    <Separator Margin="0,18,0,14" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="外部接続の診断" />
                    <TextBlock Margin="0,6,0,8" TextWrapping="Wrap"
                               Text="共有開始には不要です。現在のグローバルIPv4をAWSへHTTPS接続して確認しますが、外部から接続できることは保証しません。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" AutomationProperties.Name="グローバルIPv4"
                                 Text="{Binding GlobalIpv4, Mode=OneWay}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding CheckGlobalIpv4Command}" Content="確認する" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding CopyGlobalIpv4Command}" Content="コピー" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="セキュリティ">
                <StackPanel Margin="18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="セキュリティ" />
                    <TextBlock Margin="0,18,0,5" Text="✓ 読み取り専用（GET / HEAD）" />
                    <TextBlock Margin="0,5" Text="✓ 共有ルート境界とreparse pointを検証" />
                    <TextBlock Margin="0,5" Text="✓ CGI・アップロード・削除なし" />
                    <TextBlock Margin="0,5" Text="✓ 接続・ヘッダー・タイムアウト制限あり" />
                </StackPanel>
            </TabItem>
            <TabItem Header="ログ">
                <StackPanel Margin="18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="ログ" />
                    <TextBlock Margin="0,18,0,4" Text="転送一覧をメモリ上に最大200件保持します。" />
                    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="転送ログはローカルアプリデータの EasyHTTPServer\logs\transfers.jsonl に保存します。5 MiBで切り替え、現行を含め5世代を保持します。" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Authorization、Cookie、クエリ文字列、要求ヘッダー、接続元IP、共有の実パスは保存しません。" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Button Grid.Row="2" HorizontalAlignment="Right" TabIndex="2" IsCancel="True" Content="閉じる" />
    </Grid>
</Window>
