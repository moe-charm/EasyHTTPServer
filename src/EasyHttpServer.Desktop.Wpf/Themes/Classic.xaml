<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentBrush" Color="#000080" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#202020" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#D4D0C8" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#808080" />
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Background" Value="#D4D0C8" />
        <Setter Property="BorderBrush" Value="#404040" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</ResourceDictionary>
